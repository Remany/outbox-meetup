{
  "title": "Outbox Metrics Dashboard",
  "description": "Monitoring for Transactional Outbox pattern",
  "tags": [
    "outbox",
    "kafka",
    "spring-boot"
  ],
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Pending Events Queue",
      "type": "stat",
      "targets": [
        {
          "expr": "outbox_events_pending",
          "legendFormat": "Pending Events"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 10,
                "color": "yellow"
              },
              {
                "value": 50,
                "color": "red"
              }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "title": "Event Flow (Incoming vs Kafka Sent)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(outbox_events_stored_total[1m])",
          "legendFormat": "Incoming (to Outbox)"
        },
        {
          "expr": "rate(kafka_producer_record_send_total[1m])",
          "legendFormat": "Sent to Kafka"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      }
    },
    {
      "id": 3,
      "title": "Publication Performance",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(outbox_kafka_publication_attempts_total[1m])",
          "legendFormat": "Attempts (Outbox)"
        },
        {
          "expr": "rate(kafka_producer_record_send_total[1m])",
          "legendFormat": "Sent (Kafka)"
        },
        {
          "expr": "rate(kafka_producer_record_error_total[1m])",
          "legendFormat": "Errors (Kafka)"
        },
        {
          "expr": "rate(kafka_producer_record_retry_total[1m])",
          "legendFormat": "Retries (Kafka)"
        },
        {
          "expr": "rate(kafka_producer_buffer_exhausted_total[1m])",
          "legendFormat": "Buffer Full Events"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      }
    },
    {
      "id": 4,
      "title": "Kafka Request Latency (95th percentile)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(kafka_producer_request_latency_ms_bucket[1m])) by (le))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      }
    },
    {
      "id": 5,
      "title": "Kafka Success Rate",
      "type": "gauge",
      "targets": [
        {
          "expr": "(rate(kafka_producer_record_send_total[5m]) - rate(kafka_producer_record_error_total[5m])) / rate(kafka_producer_record_send_total[5m]) * 100",
          "legendFormat": "Success Rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              {
                "value": 0,
                "color": "red"
              },
              {
                "value": 95,
                "color": "yellow"
              },
              {
                "value": 99,
                "color": "green"
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 16
      }
    },
    {
      "id": 6,
      "title": "Errors by Type",
      "type": "bargauge",
      "targets": [
        {
          "expr": "sum by (errorType) (rate(outbox_kafka_publication_detailed_total{status=\"error\"}[5m]))",
          "legendFormat": "{{errorType}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 16
      }
    },
    {
      "id": 7,
      "title": "Outbox Backlog (Logical - Kafka Sent)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "outbox_events_stored_total - outbox_kafka_publication_success_total",
          "legendFormat": "Estimated Backlog (stored - sent)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 100,
                "color": "yellow"
              },
              {
                "value": 500,
                "color": "red"
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 24
      }
    },
    {
      "id": 8,
      "title": "Error Rate (%)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "(rate(outbox_kafka_publication_errors_total[5m]) / rate(outbox_kafka_publication_attempts_total[5m])) * 100",
          "legendFormat": "Error Rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "steps": [
              {
                "value": 0,
                "color": "green"
              },
              {
                "value": 2,
                "color": "yellow"
              },
              {
                "value": 5,
                "color": "red"
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 24
      }
    },
    {
      "id": 9,
      "title": "Kafka Request Latency Percentiles",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(kafka_producer_request_latency_ms_bucket[1m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(kafka_producer_request_latency_ms_bucket[1m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(kafka_producer_request_latency_ms_bucket[1m])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 30
      }
    },
    {
      "id": 10,
      "title": "Kafka Producer Throughput (records/sec)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(kafka_producer_record_send_total[1m])",
          "legendFormat": "Records Sent"
        },
        {
          "expr": "rate(kafka_producer_record_error_total[1m])",
          "legendFormat": "Errors"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 38
      }
    },
    {
      "id": 11,
      "title": "Kafka Request Latency",
      "type": "timeseries",
      "targets": [
        {
          "expr": "kafka_producer_request_latency_avg",
          "legendFormat": "Average"
        },
        {
          "expr": "kafka_producer_request_latency_max",
          "legendFormat": "Max"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 38
      }
    },
    {
      "id": 12,
      "title": "Producer Queue Pressure",
      "type": "timeseries",
      "targets": [
        {
          "expr": "kafka_producer_record_queue_time_avg",
          "legendFormat": "Record Queue Time"
        },
        {
          "expr": "rate(kafka_producer_buffer_exhausted_total[1m])",
          "legendFormat": "Buffer Exhausted Events"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 46
      }
    },
    {
      "id": 13,
      "title": "Retries and Batch Characteristics",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(kafka_producer_record_retry_total[1m])",
          "legendFormat": "Retries"
        },
        {
          "expr": "kafka_producer_batch_size_avg",
          "legendFormat": "Batch Size (avg)"
        },
        {
          "expr": "kafka_producer_compression_rate_avg",
          "legendFormat": "Compression Ratio"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 46
      }
    },
    {
      "id": 14,
      "title": "I/O Wait & Broker Response",
      "type": "timeseries",
      "targets": [
        {
          "expr": "kafka_producer_io_wait_ratio",
          "legendFormat": "I/O Wait Ratio"
        },
        {
          "expr": "rate(kafka_producer_request_rate[1m])",
          "legendFormat": "Requests/sec"
        },
        {
          "expr": "rate(kafka_producer_response_rate[1m])",
          "legendFormat": "Responses/sec"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 54
      }
    }
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "5s"
}
