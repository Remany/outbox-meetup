{
  "title": "Outbox Metrics Dashboard",
  "description": "Monitoring for Transactional Outbox pattern",
  "tags": [
    "outbox",
    "kafka",
    "spring-boot"
  ],
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Pending Events Queue",
      "type": "stat",
      "targets": [
        {
          "expr": "outbox_events_pending",
          "legendFormat": "Pending Events"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 10,
                "color": "yellow"
              },
              {
                "value": 50,
                "color": "red"
              }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "title": "Event Flow (Incoming vs Outgoing)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(outbox_events_stored_total[1m])",
          "legendFormat": "Incoming Events"
        },
        {
          "expr": "rate(outbox_kafka_publication_success_total[1m])",
          "legendFormat": "Successful Publications"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      }
    },
    {
      "id": 3,
      "title": "Publication Performance",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(outbox_kafka_publication_attempts_total[1m])",
          "legendFormat": "Attempts"
        },
        {
          "expr": "rate(outbox_kafka_publication_success_total[1m])",
          "legendFormat": "Success"
        },
        {
          "expr": "rate(outbox_kafka_publication_errors_total[1m])",
          "legendFormat": "Errors"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      }
    },
    {
      "id": 4,
      "title": "Publication Latency (95th percentile)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(outbox_kafka_publication_latency_seconds_bucket[1m]))",
          "legendFormat": "95th %ile"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      }
    },
    {
      "id": 5,
      "title": "Success Rate",
      "type": "gauge",
      "targets": [
        {
          "expr": "(rate(outbox_kafka_publication_success_total[5m]) / rate(outbox_kafka_publication_attempts_total[5m])) * 100",
          "legendFormat": "Success Rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              {
                "value": 0,
                "color": "red"
              },
              {
                "value": 95,
                "color": "yellow"
              },
              {
                "value": 99,
                "color": "green"
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 16
      }
    },
    {
      "id": 6,
      "title": "Errors by Type",
      "type": "bargauge",
      "targets": [
        {
          "expr": "sum by (errorType) (rate(outbox_kafka_publication_detailed_total{status=\"error\"}[5m]))",
          "legendFormat": "{{errorType}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 16
      }
    }
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "5s"
}